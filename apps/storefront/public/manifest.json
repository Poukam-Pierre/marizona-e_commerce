      "description": "Browse all products",
      "url": "/products",
      "icons": [{ "src": "/icons/shortcut-products.png", "sizes": "192x192" }]
    },
    {
      "name": "Shopping Cart",
      "short_name": "Cart",
      "description": "View your shopping cart",
      "url": "/cart",
      "icons": [{ "src": "/icons/shortcut-cart.png", "sizes": "192x192" }]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/homepage.png",
      "sizes": "1280x720",
