{
  "name": "@ecommerce-platform/source",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "nx dev storefront --port=3000 2>&1 | tee dev.log",
    "dev:admin": "nx dev admin --port=3001",
    "dev:api": "nx serve api",
    "dev:all": "nx run-many -t dev -p storefront admin api --parallel",
    "build": "nx run-many -t build -p storefront admin api",
    "build:storefront": "nx build storefront",
    "build:admin": "nx build admin",
    "build:api": "nx build api",
    "build:prod": "nx run-many -t build -p storefront admin api --configuration=production",
    "start": "node dist/apps/storefront/server.js",
    "start:storefront": "node dist/apps/storefront/server.js",
    "start:admin": "node dist/apps/admin/server.js",
    "start:api": "node dist/apps/api/main.js",
    "lint": "nx run-many -t lint -p storefront admin api",
    "lint:fix": "nx run-many -t lint -p storefront admin api --fix",
    "test": "nx run-many -t test -p storefront admin api",
    "test:coverage": "nx run-many -t test -p storefront admin api --coverage",
    "e2e": "nx run-many -t e2e -p storefront-e2e admin-e2e",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset",
    "docker:build": "docker-compose -f docker-compose.prod.yml build",
    "docker:up": "docker-compose -f docker-compose.prod.yml up -d",
    "docker:down": "docker-compose -f docker-compose.prod.yml down",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker-compose -f docker-compose.dev.yml down",
    "docker:logs": "docker-compose -f docker-compose.prod.yml logs -f",
    "docker:ps": "docker-compose -f docker-compose.prod.yml ps",
    "k8s:staging": "kubectl apply -k k8s/overlays/staging",
    "k8s:production": "kubectl apply -k k8s/overlays/production",
    "k8s:delete": "kubectl delete -k k8s/overlays/production"
  },
  "private": true,
