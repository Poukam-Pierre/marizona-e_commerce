// ============================================================================
// E-Commerce Platform - SQLite Development Schema
// Database: SQLite (for local development/sandbox)
// Version: 1.0.0
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS (SQLite uses strings instead of native enums)
// ============================================================================

/// Admin user roles with hierarchical permissions
enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  VIEWER
}

/// Product types for different fulfillment flows
enum ProductType {
  PHYSICAL
  DIGITAL
}

/// Order status for tracking order lifecycle
enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

/// Payment status for tracking payment lifecycle
enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
  PARTIAL
}

/// Inventory movement types for stock tracking
enum MovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  DAMAGE
  TRANSFER
}

/// Payment methods for future extensibility
enum PaymentMethod {
  WHATSAPP
  BANK_TRANSFER
  CREDIT_CARD
  E_WALLET
  COD
}

// ============================================================================
// ADMIN DOMAIN
// ============================================================================

model AdminUser {
  id       String    @id @default(cuid())
  email    String    @unique
  password String
  name     String
  role     AdminRole @default(VIEWER)
  avatar   String?

  emailVerified     DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?

  isActive    Boolean   @default(true)
  isLocked    Boolean   @default(false)
  lockedUntil DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  auditLogs AdminAuditLog[]
  sessions  AdminSession[]

  @@index([email])
  @@index([role])
  @@map("admin_users")
}

model AdminSession {
  id          String   @id @default(cuid())
  adminUserId String
  token       String   @unique
  ipAddress   String?
  userAgent   String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("admin_sessions")
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  entity      String
  entityId    String?
  oldData     String? // JSON string for SQLite
  newData     String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

// ============================================================================
// PRODUCT DOMAIN
// ============================================================================

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  image       String?

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")

  order    Int     @default(0)
  isActive Boolean @default(true)

  metaTitle       String?
  metaDescription String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  products Product[]

  @@index([slug])
  @@map("categories")
}

model Product {
  id          String  @id @default(cuid())
  sku         String  @unique
  name        String
  slug        String  @unique
  description String?

  type ProductType @default(PHYSICAL)

  price        Float // SQLite doesn't support Decimal
  comparePrice Float?
  costPrice    Float?

  inventoryQuantity Int     @default(0)
  inventoryTracked  Boolean @default(true)
  lowStockThreshold Int     @default(10)

  weight Float?
  length Float?
  width  Float?
  height Float?

  downloadUrl    String?
  downloadLimit  Int?
  downloadExpiry Int?

  ownerName     String?
  ownerWhatsapp String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  image           String?
  metaTitle       String?
  metaDescription String?

  isActive     Boolean @default(true)
  isFeatured   Boolean @default(false)
  isBestSeller Boolean @default(false)

  viewCount   Int    @default(0)
  soldCount   Int    @default(0)
  rating      Float?
  reviewCount Int    @default(0)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  images             ProductImage[]
  variants           ProductVariant[]
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]
  cartItems          CartItem[]

  @@index([slug])
  @@index([sku])
  @@index([type])
  @@index([isActive])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  order     Int     @default(0)
  isPrimary Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id        String @id @default(cuid())
  productId String
  sku       String @unique
  name      String

  option1Name  String?
  option1Value String?
  option2Name  String?
  option2Value String?
  option3Name  String?
  option3Value String?

  price        Float
  comparePrice Float?

  inventoryQuantity Int @default(0)

  weight Float?
  image  String?

  isActive Boolean @default(true)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}

model InventoryMovement {
  id        String  @id @default(cuid())
  productId String
  variantId String?

  type      MovementType
  quantity  Int
  reason    String?
  reference String?

  previousStock Int
  newStock      Int

  notes  String?
  userId String?

  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([createdAt])
  @@map("inventory_movements")
}

// ============================================================================
// CUSTOMER DOMAIN
// ============================================================================

model Customer {
  id     String  @id @default(cuid())
  email  String? @unique
  phone  String? @unique
  name   String?
  avatar String?

  whatsappNumber String?
  whatsappOptIn  Boolean @default(false)

  password String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  orders    Order[]
  addresses CustomerAddress[]
  cartItems CartItem[]

  @@index([email])
  @@index([phone])
  @@map("customers")
}

model CustomerAddress {
  id         String @id @default(cuid())
  customerId String

  label      String?
  name       String
  phone      String
  address    String
  city       String
  province   String
  postalCode String
  country    String  @default("Cameroon")

  isDefault Boolean @default(false)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

// ============================================================================
// ORDER DOMAIN
// ============================================================================

model Order {
  id String @id @default(cuid())

  orderNumber String @unique

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  customerName     String
  customerEmail    String?
  customerPhone    String
  customerWhatsapp String?

  shippingName       String
  shippingPhone      String
  shippingAddress    String
  shippingCity       String
  shippingProvince   String
  shippingPostalCode String?
  shippingCountry    String  @default("Cameroon")

  billingName       String?
  billingPhone      String?
  billingAddress    String?
  billingCity       String?
  billingProvince   String?
  billingPostalCode String?

  subtotal     Float
  discount     Float @default(0)
  shippingCost Float @default(0)
  tax          Float @default(0)
  total        Float

  currency String @default("IDR")

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  paymentMethod PaymentMethod @default(WHATSAPP)
  paymentId     String?
  paidAt        DateTime?

  shippedAt        DateTime?
  deliveredAt      DateTime?
  trackingNumber   String?
  shippingProvider String?

  digitalDownloadUrl    String?
  digitalDownloadExpiry DateTime?

  customerNotes String?
  adminNotes    String?

  whatsappSentAt      DateTime?
  whatsappConfirmedAt DateTime?

  couponId   String?
  couponCode String?

  confirmedAt DateTime?
  cancelledAt DateTime?
  refundedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items OrderItem[]

  @@index([orderNumber])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productSku   String
  productName  String
  productImage String?

  variantId   String?
  variantName String?

  unitPrice  Float
  totalPrice Float

  quantity Int

  downloadUrl    String?
  downloadCount  Int       @default(0)
  downloadLimit  Int?
  downloadExpiry DateTime?

  productType ProductType @default(PHYSICAL)

  isShipped   Boolean   @default(false)
  shippedAt   DateTime?
  isDelivered Boolean   @default(false)
  deliveredAt DateTime?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("order_items")
}

// ============================================================================
// CART DOMAIN
// ============================================================================

model CartItem {
  id String @id @default(cuid())

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  sessionId String?

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId String?

  quantity Int

  price Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([sessionId])
  @@map("cart_items")
}

// ============================================================================
// COUPON DOMAIN
// ============================================================================

model Coupon {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?

  type  String
  value Float

  minOrderValue Float?
  maxDiscount   Float?
  usageLimit    Int?
  usageCount    Int    @default(0)

  productIds  String // JSON array for SQLite
  categoryIds String

  startsAt  DateTime?
  expiresAt DateTime?
  isActive  Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@map("coupons")
}

// ============================================================================
// SETTINGS DOMAIN
// ============================================================================

model Setting {
  id       String @id @default(cuid())
  key      String @unique
  value    String // JSON string for SQLite
  category String @default("general")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@map("settings")
}

// ============================================================================
// WEBHOOK DOMAIN
// ============================================================================

model WebhookEvent {
  id        String    @id @default(cuid())
  type      String
  payload   String // JSON string for SQLite
  status    String    @default("pending")
  attempts  Int       @default(0)
  lastError String?
  sentAt    DateTime?

  createdAt DateTime @default(now())

  @@index([type])
  @@index([status])
  @@map("webhook_events")
}

// ============================================================================
// PUSH NOTIFICATION DOMAIN
// ============================================================================

model PushSubscription {
  id       String @id @default(cuid())
  endpoint String @unique
  p256dh   String // Public key for encryption
  auth     String // Auth secret

  userId    String? // Optional user association
  userAgent String? // Browser/device info

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([endpoint])
  @@index([userId])
  @@map("push_subscriptions")
}
